# Sovereign Model Layer (paper Section 4) - role-routed LOCAL models.
# Nothing below is required to run the demo: with no server reachable at
# these URLs, PlannerAgent/CriticAgent/the coder tool all fall back to
# deterministic behaviour exactly like before.
#
# To actually use the models the paper names:
#   1. Install Ollama (https://ollama.com) or vLLM.
#   2. ollama pull hermes3:70b   (or hermes3:8b on smaller hardware)
#      ollama pull qwen2.5-coder:32b
#      ollama pull deepseek-coder-v2:lite
#   3. ollama serve   (defaults to http://localhost:11434)
#   4. Run the demo - PlannerAgent will now route through Hermes 3 instead
#      of its keyword fallback. See config/llm_routing.yaml to change
#      which model serves which role.
OLLAMA_BASE_URL=http://localhost:11434/v1
VLLM_BASE_URL=http://localhost:8000/v1
# Order to try local backends in; "anthropic" only activates if you also
# set AGENTIC_ALLOW_CLOUD_FALLBACK=1 below.
LLM_BACKEND_PRIORITY=ollama,vllm,anthropic

# Optional, OFF by default: a hosted cloud fallback for people iterating
# on this project without a local GPU. Sovereignty (Section 3.5) is the
# default - a bare ANTHROPIC_API_KEY here does nothing unless you also
# flip this to 1.
AGENTIC_ALLOW_CLOUD_FALLBACK=0
ANTHROPIC_API_KEY=

# Optional overrides
AGENTIC_DEFAULT_MODEL=claude-sonnet-4-6
AGENTIC_MAX_REPLANS=2

# Used only once memory/orchestrator persistence stubs are implemented —
# harmless to leave unset for now.
REDIS_URL=redis://localhost:6379/0
POSTGRES_URL=postgresql://localhost:5432/agentic
QDRANT_URL=http://localhost:6333
